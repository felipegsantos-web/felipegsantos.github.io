---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign pages = site.pages | where_exp: "p", "p.lang and p.ref" | sort: "url" %}
{%- for p in pages %}
{%- assign pair = pages | where: "ref", p.ref | where_exp: "q", "q.lang != p.lang" | first %}
{%- if p.lang == "en" %}{% assign url_en = p.url %}{% assign url_es = pair.url %}{% else %}{% assign url_en = pair.url %}{% assign url_es = p.url %}{% endif %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    {%- if p.last_modified_at %}
    <lastmod>{{ p.last_modified_at | date_to_xmlschema }}</lastmod>
    {%- endif %}
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ url_en }}"/>
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.url }}{{ url_es }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ url_en }}"/>
  </url>
{%- endfor %}
</urlset>
